# Editor / tooling
.aider*
.vscode/
.qt/

# Build trees (cmake/make) — every variant: build/ build-asan/ build-tsan/ build-gcc15/
# build_test_migration/ build_lateral_probe/ build-make-copilot/ cmake-build*/ …
# NOTE: generated/ is intentionally NOT ignored — the robocompdsl Ice stubs are committed; only the
# build output UNDER it (*_autogen/) and the in-source cmake droppings are ignored.
build*/
cmake-build*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
*_autogen/
.trt_cache/

# Compiled / binary output
bin/
*.o
*.so
*.a
a.out
__pycache__/
*.pyc

# Large ML model weights (too big for git; regenerate/export locally)
*.onnx
*.pt
*.engine

# Run artifacts + scratch edits/backups
# Per-component run logs (chair's ai2_log.csv, ring_metaconcept's ring_fit.csv, …).
# NOTE: a bare `etc/*.csv` contains a slash, so git anchors it to THIS directory and it
# never matched <component>/etc/ — `git add <component>/` then silently staged run logs.
# (.gitignore has no trailing comments: a `#` after the pattern becomes part of it.)
**/etc/*.csv
# Rotated previous runs, kept beside the live file by rc::diag::open_rotating
# (common/diag_log/rotating_csv.h): "<name>.csv.<YYYYmmdd_HHMMSS>". The rule above does NOT
# cover these — the timestamp comes AFTER the extension, so the name does not end in .csv.
**/etc/*.csv.*
# ...and the same one level down: `**/etc/*.csv` does NOT match `etc/archive/foo.csv`,
# which is how a 6.7 MB archived run log stayed tracked under a rule meant to cover it.
**/etc/**/*.csv
*.log
*.bak
*.back
*.new
*.poisoned*

# Scratch / throwaway experiments
caca/

# Large non-source blobs. GitHub HARD-REJECTS any file over 100 MB, so one of these in a
# commit blocks the whole push — retina/models.tar.gz is 1.3 GB. These are build/runtime
# assets fetched or produced locally, not repository content.
**/models.tar.gz
# Captured frame dumps (retina/etc/depth_frames held 1108 jpgs).
**/etc/depth_frames/
