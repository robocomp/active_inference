# hood.obj — canopy chimney hood, generated procedurally from the live capture.
# Unit convention (matches refrigerator_concept/meshes/fridge.obj): x,y in [-0.5,0.5], z in [0,1].
# ★+Y is the WALL side and its face is VERTICAL: HoodBelief::back_centre puts the back face at
# c + (h/2)*(local +Y), so a symmetric pyramid would slope INTO the wall and leave the flat face
# pointing at the room. Only the front and the two sides taper.
mtllib hood.mtl
o hood
usemtl hood
