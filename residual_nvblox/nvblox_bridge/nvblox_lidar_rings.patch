+float Lidar::polarToRow(float polar_rad) const {
+  if (num_rings_ < 2) {
+    return (polar_rad - start_polar_angle_rad_) * elevation_pixels_per_rad_;
+  }
+  const float* c = ring_polar_rad_;
+  int lo = 0, hi = num_rings_ - 1;   // last segment start with c[i] <= polar, clamped to [0, n-2]
+  while (hi - lo > 1) {
+    const int mid = (lo + hi) / 2;
+    if (c[mid] <= polar_rad) lo = mid; else hi = mid;
+  }
+  if (polar_rad >= c[num_rings_ - 1]) lo = num_rings_ - 2;
+  return lo + 0.5f + (polar_rad - c[lo]) / (c[lo + 1] - c[lo]);
+}
+
+float Lidar::rowToPolar(float v) const {
+  if (num_rings_ < 2) {
+    return v * rads_per_pixel_elevation_ + start_polar_angle_rad_;
+  }
+  const float w = v - 0.5f;
+  int i = static_cast<int>(floorf(w));
+  i = i < 0 ? 0 : (i > num_rings_ - 2 ? num_rings_ - 2 : i);
+  return ring_polar_rad_[i] + (w - i) * (ring_polar_rad_[i + 1] - ring_polar_rad_[i]);
+}
+
+float Lidar::ring_gap_rad(int row, bool towards_larger_polar) const {
+  if (num_rings_ < 2) return rads_per_pixel_elevation_;
+  row = row < 0 ? 0 : (row > num_rings_ - 1 ? num_rings_ - 1 : row);
+  if (towards_larger_polar) {
+    row = row > num_rings_ - 2 ? num_rings_ - 2 : row;
+  } else {
+    row = row > 0 ? row - 1 : 0;
+  }
+  return ring_polar_rad_[row + 1] - ring_polar_rad_[row];
+}
+
+void Lidar::set_ring_elevations_rad(const float* elevation_rad, int n) {
+  NVBLOX_CHECK(n == num_elevation_divisions_ && n >= 2 && n <= kMaxRings, "");
+  for (int i = 0; i < n; ++i) ring_polar_rad_[i] = M_PI / 2.0f - elevation_rad[i];
+  std::sort(ring_polar_rad_, ring_polar_rad_ + n);
+  num_rings_ = n;
+  max_angle_above_zero_elevation_rad_ = M_PI / 2.0f - ring_polar_rad_[0];
+  min_angle_below_zero_elevation_rad_ = M_PI / 2.0f - ring_polar_rad_[n - 1];
+  vertical_fov_rad_ = ring_polar_rad_[n - 1] - ring_polar_rad_[0];
+  rads_per_pixel_elevation_ = vertical_fov_rad_ / static_cast<float>(n - 1);
+  elevation_pixels_per_rad_ = 1.0f / rads_per_pixel_elevation_;
+  start_polar_angle_rad_ = ring_polar_rad_[0] - rads_per_pixel_elevation_ / 2.0f;
+}
