\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Is the declared uncertainty honest?} Every matched corner of 594 annotated floor plans: declared $\sigma $ against the error it actually made. \emph  {Left}, propagating only the walls' statistical uncertainty: the red median is flat, so a corner claiming \SI {1}{\centi \meter } is no more accurate than one claiming \SI {5}{\centi \meter }, and the cloud sits far above $\mathrm  {error}=\sigma $ at the tight end. \emph  {Right}, with the irreducible term of \eqref  {eq:corner}: the median tracks the diagonal and the bound holds. The dotted line is the publication gate.}}{4}{figure.1}\protected@file@percent }
\newlabel{fig:calib}{{1}{4}{\textbf {Is the declared uncertainty honest?} Every matched corner of 594 annotated floor plans: declared $\sigma $ against the error it actually made. \emph {Left}, propagating only the walls' statistical uncertainty: the red median is flat, so a corner claiming \SI {1}{\centi \meter } is no more accurate than one claiming \SI {5}{\centi \meter }, and the cloud sits far above $\mathrm {error}=\sigma $ at the tight end. \emph {Right}, with the irreducible term of \eqref {eq:corner}: the median tracks the diagonal and the bound holds. The dotted line is the publication gate}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {The channel is calibrated only while the robot moves.} $\ensuremath  {\mathrm  {NIS}}$ per rotation band over a \SI {200}{\meter } tour, with the pose-induced corner uncertainty $\sigma _{\mathrm  {pred}}$ overlaid. Three independent bands of genuine motion sit at \numrange {0.90}{0.97}. At rest $\sigma _{\mathrm  {pred}}$ collapses while the innovation grows, and under fast rotation the innovation grows again---two distinct mechanisms bracketing a correctly calibrated middle.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:motion}{{2}{4}{\textbf {The channel is calibrated only while the robot moves.} $\nis $ per rotation band over a \SI {200}{\meter } tour, with the pose-induced corner uncertainty $\sigma _{\mathrm {pred}}$ overlaid. Three independent bands of genuine motion sit at \numrange {0.90}{0.97}. At rest $\sigma _{\mathrm {pred}}$ collapses while the innovation grows, and under fast rotation the innovation grows again---two distinct mechanisms bracketing a correctly calibrated middle}{figure.2}{}}
